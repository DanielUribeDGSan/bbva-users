---
import '../styles/global.css';
import { Home, Users, HelpCircle, LogOut } from 'lucide-react';
import AccessModal from '../components/AccessModal';
import DashboardTopbar from '../components/DashboardTopbar';

interface Props {
	title: string;
    activeMenu?: string;
}

const { title, activeMenu = 'dashboard' } = Astro.props;

const menuItems = [
    { id: 'dashboard', label: 'Dashboard', href: '/' },
    { id: 'users', label: 'Usuarios', href: '/users' }
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Dashboard" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
        <div class="min-h-screen bg-[#f7f8f8]">
            <aside id="main-sidebar" class="fixed inset-y-0 left-0 z-40 hidden w-24 flex-col items-center border-r border-gray-100 bg-white py-6 shadow-sm lg:flex">
                <a href="/" class="mb-12 flex size-10 shrink-0 cursor-pointer items-center justify-center rounded-[12px] bg-[#072f92]" aria-label="BBVA Estratega Life">
                    <svg aria-hidden="true" viewBox="0 0 40 40" class="size-7" fill="none">
                        <path d="M7 11.5 20 28.5 33 11.5" stroke="white" stroke-width="6" stroke-linecap="square" stroke-linejoin="miter"></path>
                    </svg>
                </a>
                <nav class="flex w-full flex-col gap-3 px-3">
                    <a href="/" class:list={["sidebar-link", activeMenu === 'dashboard' && 'active']}><Home size={20}/><span>Home</span></a>
                    <a href="/users" class:list={["sidebar-link", activeMenu === 'users' && 'active']}><Users size={20}/><span>Usuarios</span></a>
                </nav>
                <div class="mt-auto flex w-full flex-col gap-5 px-4">
                    <button class="sidebar-utility" aria-label="Ayuda"><HelpCircle size={20}/></button>
                    <button id="logout-button" class="sidebar-utility" aria-label="Cerrar sesión"><LogOut size={20}/></button>
                </div>
            </aside>
            <div id="mobile-backdrop" class="fixed inset-0 z-30 hidden bg-slate-950/30 lg:hidden"></div>
            <div class="min-h-screen min-w-0 lg:ml-24">
                <DashboardTopbar client:load />
                <main class="min-w-0 px-4 pb-6 pt-3 sm:px-6 sm:pb-8 lg:px-8 lg:pt-4">
                    <slot />
                </main>
            </div>
        </div>
        <AccessModal client:only="react" />
		<script is:inline>
            const sidebar = document.querySelector('#main-sidebar');
            const backdrop = document.querySelector('#mobile-backdrop');
            const toggleMenu = (open) => {
                sidebar?.classList.toggle('mobile-open', open);
                backdrop?.classList.toggle('hidden', !open);
            };
            document.querySelector('[data-mobile-menu]')?.addEventListener('click', () => toggleMenu(true));
            backdrop?.addEventListener('click', () => toggleMenu(false));
            document.querySelector('#logout-button')?.addEventListener('click', () => {
                localStorage.removeItem('site_access_granted');
                location.assign('/');
            });
        </script>
	</body>
</html>
