---
import '../styles/global.css';
import { Settings, Bell, User } from 'lucide-react';

interface Props {
	title: string;
    activeMenu?: string;
}

const { title, activeMenu = 'dashboard' } = Astro.props;

const menuItems = [
    { id: 'dashboard', label: 'Dashboard', href: '/' },
    { id: 'users', label: 'Usuarios', href: '/users' }
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Dashboard" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
        <div class="app-wrapper">
            <header class="flex flex-wrap justify-between items-center mb-10 gap-y-6">
                <a href="/" class="flex items-center text-2xl font-medium tracking-tight bg-white px-5 py-2 rounded-full shadow-sm hover:shadow-md transition-shadow cursor-pointer text-text-main hover:text-[#001391]">
                    BBVA Estratega Life
                </a>

                <nav class="glass-nav flex w-full md:w-auto justify-center order-last md:order-none">
                    {menuItems.map(item => (
                        <a href={item.href} class={`glass-nav-item text-center flex-1 md:flex-none ${activeMenu === item.id ? 'active' : ''}`}>
                            {item.label}
                        </a>
                    ))}
                </nav>

                <div class="flex items-center gap-3">
                    <button class="btn-icon">
                        <Bell size={18} />
                    </button>
                    <button class="btn-icon">
                        <User size={18} />
                    </button>
                </div>
            </header>

            <main>
                <slot />
            </main>
        </div>
	</body>
</html>
